  5.             local extra ""
  6.             local lab ""
  7.             if `mp' local extra "& importo_lotto != 139000"
  8.             if `mp' local lab " excl. 139000"
  9.             capture rdrobust `v' xr if ${g_`g'} `extra', h(20000) kernel(t
> riangular) masspoints(off)
 10.             if !_rc {
 11.                 di as text "  `g'`lab': coef = " %7.4f e(tau_cl) "  SE = "
