. * ---- Results collector and table writers (added 14 Nov 2026) --------------
> --
. * WHAT: four small programs that write results to files. They change no
. * estimate; they only record and format what the code already estimates.
. * WHY: the coefficients of the review report (results/report_pdf/) used to
. * live only in this log and in RESULTS comments. Now every reported estimate 
> is
. * written to results/tables/coefficients${SFX}.csv as it is computed, and
. * Part 8 builds the LaTeX tables from that file (and from the stored
. * estimates, with esttab), so no number in the report is copied by hand.
. *
. * rpost <table> <row> <col> [, options]   one estimate -> one row of the file
. *   (default)  reghdfe / ivreghdfe: coefficient 1.below#1.post
. *   coef(name) another coefficient (e.g. direct for the LATE)
. *   rd         rdrobust: stores BELOW minus ABOVE (= −e(tau_cl)), the same
. *              sign as below×post, so every table reads the same way
. *   manual     b(#) se(#) [n(#) lo(#) hi(#)]: numbers computed by hand
. *              (bootstrap, differences of two rdrobust estimates)
. *   extra(#)   one more number (e.g. Kleibergen–Paap F, number of clusters)
. * p: t distribution with e(df_r) when the command reports it, else normal.
. * lo, hi: 95% CI, b ± 1.96·se unless given (bootstrap percentiles).
. capture program drop rpost

. program define rpost
  1.     syntax namelist(min=3 max=3) [, Coef(string) RD MANual B(real 0) SE(re
> al 0) ///
>         N(real -1) LO(real -999) HI(real -999) Extra(real -999)]
  2.     tokenize `namelist'
  3.     if "`manual'" != "" {
  4.         local bb = `b'
  5.         local ss = `se'
  6.         local nn = cond(`n' < 0, ., `n')
  7.         local pp = 2*normal(-abs(`bb'/`ss'))
  8.     }
  9.     else if "`rd'" != "" {
 10.         local bb = -e(tau_cl)
 11.         local ss = e(se_tau_cl)
 12.         local nn = e(N_h_l) + e(N_h_r)
 13.         local pp = 2*normal(-abs(`bb'/`ss'))
 14.     }
 15.     else {
 16.         if "`coef'" == "" local coef "1.below#1.post"
 17.         local bb = _b[`coef']
 18.         local ss = _se[`coef']
 19.         local nn = e(N)
 20.         if missing(e(df_r)) local pp = 2*normal(-abs(`bb'/`ss'))
 21.         else                local pp = 2*ttail(e(df_r), abs(`bb'/`ss'))
 22.     }
 23.     local ll = cond(`lo' == -999, `bb' - 1.96*`ss', `lo')
 24.     local hh = cond(`hi' == -999, `bb' + 1.96*`ss', `hi')
 25.     local xx = cond(`extra' == -999, ., `extra')
 26.     post RES ("`1'") ("`2'") ("`3'") (`bb') (`ss') (`pp') (`nn') (`ll') (`
> hh') (`xx')
 27. end

. 
. * cstore <name> <outcome>: adds the mean of the outcome among control-period
. * lots below 139k in the estimation sample (cmean) and stores the estimates
. * under <name> for the esttab tables of Part 8.
. capture program drop cstore

. program define cstore
  1.     args name var
  2.     quietly summarize `var' if e(sample) & ${g_CTRL} & below == 1, meanonl
> y
  3.     quietly estadd scalar cmean = r(mean)
  4.     estimates store `name'
  5. end

. 
. * textab: writes the body of a LaTeX table (rows only; the report file holds
. * the header) from the collector data IN MEMORY. One line per row id: the
. * label, then for each column id the coefficient with stars, and a second
. * line with the SE in parentheses (or the 95% CI in brackets with ci).
. *   rows(): row ids; rowlab(): labels, quoted, same order; cols(): column ids
. *   fmt(): one display format per row (default %12.3f); cfmt(): one per
. *   column instead (used when columns hold outcomes in different units)
. *   p-value stars: * < 0.10, ** < 0.05, *** < 0.01
. capture program drop textab

. program define textab
  1.     syntax using/, Tbl(string) Rows(string) Cols(string) ROWLab(string asi
> s) ///
>         [Fmt(string) CFmt(string) CI]
  2.     tempname fh
  3.     file open `fh' using `"`using'"', write replace
  4.     local labs `"`rowlab'"'
  5.     local i 0
  6.     foreach r of local rows {
  7.         local ++i
  8.         gettoken lab labs : labs
  9.         local f : word `i' of `fmt'
 10.         if "`f'" == "" local f "%12.3f"
 11.         local l1 `"`lab'"'
 12.         local l2 ""
 13.         local j 0
 14.         foreach c of local cols {
 15.             local ++j
 16.             if "`cfmt'" != "" local f : word `j' of `cfmt'
 17.             quietly count if tbl == "`tbl'" & row == "`r'" & col == "`c'"
 18.             if r(N) == 0 {
 19.                 local l1 `"`l1' & "'
 20.                 local l2 `"`l2' & "'
 21.                 continue
 22.             }
 23.             quietly summarize b if tbl == "`tbl'" & row == "`r'" & col == 
> "`c'", meanonly
 24.             local bb = r(mean)
 25.             quietly summarize se if tbl == "`tbl'" & row == "`r'" & col ==
>  "`c'", meanonly
 26.             local ss = r(mean)
 27.             quietly summarize p if tbl == "`tbl'" & row == "`r'" & col == 
> "`c'", meanonly
 28.             local pp = r(mean)
 29.             local st ""
 30.             if `pp' < 0.10 local st "*"
 31.             if `pp' < 0.05 local st "**"
 32.             if `pp' < 0.01 local st "***"
 33.             local bs : display `f' `bb'
 34.             local bs = strtrim("`bs'")
 35.             local l1 `"`l1' & `bs'`st'"'
 36.             if "`ci'" != "" {
 37.                 quietly summarize lo if tbl == "`tbl'" & row == "`r'" & co
> l == "`c'", meanonly
 38.                 local a : display `f' r(mean)
 39.                 quietly summarize hi if tbl == "`tbl'" & row == "`r'" & co
> l == "`c'", meanonly
 40.                 local z : display `f' r(mean)
 41.                 local l2 `"`l2' & {\footnotesize [`=strtrim("`a'")', `=str
> trim("`z'")']}"'
 42.             }
 43.             else if !missing(`ss') {
 44.                 local sd : display `f' `ss'
 45.                 local l2 `"`l2' & {\footnotesize (`=strtrim("`sd'")')}"'
 46.             }
 47.             else local l2 `"`l2' & "'
 48.         }
 49.         file write `fh' `"`l1' \\"' _n
 50.         file write `fh' `"`l2' \\[2pt]"' _n
 51.     }
 52.     file close `fh'
 53. end

. 
. * tab_main: two-panel esttab table, one column per outcome.
. * Panel A: ITT (below×post) with N and the control mean; Panel B: LATE
. * (direct award instrumented by below×post) with the Kleibergen–Paap F.
. capture program drop tab_main

. program define tab_main
  1.     syntax using/, ITT(namelist) IV(namelist) TItles(string asis)
  2.     local k : word count `itt'
  3.     esttab `itt' using `"`using'"', replace booktabs nonumbers ///
>         mtitles(`titles') keep(1.below#1.post) ///
>         coeflabels(1.below#1.post "Below 139k \texttimes{} P2") ///
>         b(a3) se(a3) star(* 0.10 ** 0.05 *** 0.01) ///
>         stats(N cmean, labels("Observations" "Control mean below 139k") fmt(%
> 9.0fc a3)) ///
>         prehead("\begin{tabular}{l*{`k'}{c}}" "\toprule") ///
>         posthead("\midrule" "\multicolumn{`=`k'+1'}{l}{\textit{A. Reduced for
> m (ITT)}}\\") ///
>         prefoot("\addlinespace") postfoot("\midrule") nonotes
  4.     esttab `iv' using `"`using'"', append booktabs nonumbers nomtitles ///
>         keep(direct) coeflabels(direct "Direct award (LATE)") ///
>         b(a3) se(a3) star(* 0.10 ** 0.05 *** 0.01) ///
>         stats(widstat, labels("Kleibergen--Paap F") fmt(%9.0f)) ///
>         prehead("\multicolumn{`=`k'+1'}{l}{\textit{B. Effect of direct award 
> (LATE)}}\\") ///
>         posthead("\addlinespace[1pt]") prefoot("\addlinespace") postfoot("\bo
> ttomrule" "\end{tabular}") nonotes
  5. end

