  5.         if "`var'" == "direct" local cond "1"
  6. 
.         capture reghdfe `var' i.below##c.x [aw=kw40] ///
>             if ${g_`g'} & pnrr == 0 & abs(x) <= 40000 & `cond', ///
>             absorb(cpv2 region ym) vce(cluster authority_id)
  7.         if !_rc {
  8.             di as text "  `var' (`g'): " %8.4f _b[1.below] " (" %7.4f _se[
> 1.below] ")" ///
>                 "  N=" e(N)
  9.             rpost Mplac p139_`g' `var', coef(1.below)
 10.         }
 11.     }
 12. }

