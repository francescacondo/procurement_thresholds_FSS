. file open `fh' using "`T'/I_bunch_groups${SFX}.tex", write replace

. local prev ""

. forvalues i = 1/`=_N' {
  2.     local grp = grouping[`i']
  3.     if "`grp'" != "`prev'" {
  4.         local head = cond("`grp'" == "contract", "Contract type", ///
>             cond("`grp'" == "central", "Central vs other authorities", ///
>             cond("`grp'" == "macro", "Macro area", "Legal type of authority (A
> NAC register)")))
  5.         if "`prev'" != "" file write `fh' "\addlinespace" _n
  6.         file write `fh' "\multicolumn{5}{l}{\textit{`head'}} \\" _n
  7.         local prev "`grp'"
  8.     }
  9.     local lev = level[`i']
 10.     local gap = cond(gap[`i'] == 0 & gap_lo[`i'] == 0, "reference", ///
>         string(gap[`i'], "%5.1f") + " [" + string(gap_lo[`i'], "%5.1f") + ", "
>  + ///
>         string(gap_hi[`i'], "%5.1f") + "]")
 11.     file write `fh' "`lev' & " %5.1f (bP2[`i']) " & " %5.1f (b${CTRL_G}[`i'
> ]) ///
>         " & " %5.1f (d[`i']) " [" %5.1f (d_lo[`i']) ", " %5.1f (d_hi[`i']) "] 
> & `gap' \\" _n
 12. }

. file close `fh'

