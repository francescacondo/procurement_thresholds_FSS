. capture program drop bunch_spec

. program define bunch_spec, rclass
  1.     * args: bins file, group, poly order, excl. window below, above, round
> -5k dummies (0/1)
.     args file g K el eh r5
  2.     use "`file'", clear
  3.     keep if grp == "`g'" & bin > 100000 & bin < 200000
  4.     gen float z = (bin - 139000) / 1000
  5.     forvalues j = 1/`K' {
  6.         gen double z`j' = z^`j'
  7.     }
  8.     gen byte r10 = mod(bin + 500, 10000) == 0
  9.     gen byte r5  = mod(bin + 500, 5000) == 0 & !r10
 10.     gen byte ex  = bin > 139000 - `el' & bin < 139000 + `eh'
 11.     local rr "r10"
 12.     if `r5' local rr "r10 r5"
 13.     quietly regress n z1-z`K' `rr' if !ex
 14.     predict double cf
 15.     quietly summarize n if ex & bin < 139000
 16.     local a = r(sum)
 17.     quietly summarize cf if ex & bin < 139000
 18.     local c = r(sum)
 19.     local m = r(mean)
 20.     quietly summarize n if ex & bin > 139000
 21.     local aa = r(sum)
 22.     quietly summarize cf if ex & bin > 139000
 23.     return scalar missing = r(sum) - `aa'
 24.     return scalar excess  = `a' - `c'
 25.     return scalar b       = (`a' - `c') / `m'
 26. end

