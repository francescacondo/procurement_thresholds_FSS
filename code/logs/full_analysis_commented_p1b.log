. 
. 
. * ===========================================================================
> ===
. * 3.3  BOOTSTRAP: P2, CONTROL PERIOD, AND THEIR DIFFERENCE
. * ===========================================================================
> ===
. * WHY bootstrap? The bunching estimator is nonlinear (polynomial + bin counts
> ),
. * so we can't get analytical SEs easily. We use residual resampling:
. * resample the polynomial residuals, add them to the fitted values, re-estima
> te.
. * 200 replications per period.
. *
. * WHY also the control period? The headline is the DIFFERENCE b_hat(P2) −
. * b_hat(control): bunching at 139k created by the reform, net of any heaping
. * at 139k that existed anyway. P2 and the control period are different lots,
. * so their bootstrap draws are independent; replication r of the difference i
> s
. * draw r of P2 minus draw r of the control. P2 is bootstrapped first with the
. * same seed as before, so its draws reproduce the earlier P2-only results.
. 
. di as text _n "--- Bootstrap: P2 and $CTRL_G bunching ---"

--- Bootstrap: P2 and P1b bunching ---

. 
. save "data/intermediate/_lots_temp.dta", replace
(file data/intermediate/_lots_temp.dta not found)
file data/intermediate/_lots_temp.dta saved

. 
. local B = 200

. tempname ph

. postfile `ph' str4 grp int rep float b_rep using "data/intermediate/_boot_b.d
> ta", replace
(file data/intermediate/_boot_b.dta not found)

. set seed 20261104

. 
. foreach g in P2 $CTRL_G {
  2.     use "data/intermediate/_lots_temp.dta", clear
  3.     keep if ${g_`g'} & !missing(bin_bunch)
  4.     gen byte one = 1
  5.     collapse (sum) count=one, by(bin_bunch bin_norm)
  6. 
.     gen byte excluded = (bin_bunch >= (`cutoff' - `excl_lo') & bin_bunch < (`
> cutoff' + `excl_hi'))
  7.     forvalues j = 2/7 {
  8.         gen float bin_norm`j' = bin_norm^`j'
  9.     }
 10. 
.     * Round-number dummies (as in 3.2)
.     gen byte round10k = (mod(bin_bunch + 500, 10000) == 0)
 11.     gen byte round5k  = (mod(bin_bunch + 500, 5000) == 0) & !round10k
 12. 
.     reg count bin_norm bin_norm2 bin_norm3 bin_norm4 bin_norm5 ///
>         bin_norm6 bin_norm7 round10k round5k if excluded == 0
 13.     predict resid, residuals
 14.     predict fitted
 15. 
.     * Sort so excluded==0 rows come first (for clean bootstrap draws)
.     sort excluded bin_bunch
 16.     count if excluded == 0
 17.     local n_fit = r(N)
 18. 
.     forvalues b = 1/`B' {
 19.         quietly {
 20.             * Resample residuals from NON-EXCLUDED rows only
.             gen float resid_boot = resid
 21.             replace resid_boot = resid[ceil(runiform() * `n_fit')] if excl
> uded == 0
 22.             gen float count_boot = fitted + resid_boot
 23.             replace count_boot = count if excluded == 1
 24.             replace count_boot = max(0, count_boot)
 25. 
.             reg count_boot bin_norm bin_norm2 bin_norm3 bin_norm4 bin_norm5 /
> //
>                 bin_norm6 bin_norm7 round10k round5k if excluded == 0
 26.             predict cf_boot
 27. 
.             summarize count_boot if bin_bunch >= (`cutoff' - `excl_lo') & bin
> _bunch < `cutoff'
 28.             local actual_b = r(sum)
 29.             summarize cf_boot if bin_bunch >= (`cutoff' - `excl_lo') & bin
> _bunch < `cutoff'
 30.             local cf_b = r(sum)
 31.             * Normalise by avg counterfactual at threshold
.             local avg_cf_b = r(mean)
 32.             local b_rep = (`actual_b' - `cf_b') / `avg_cf_b'
 33. 
.             post `ph' ("`g'") (`b') (`b_rep')
 34.             drop resid_boot count_boot cf_boot
 35.         }
 36.     }
 37. }
