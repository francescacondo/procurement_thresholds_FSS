  3.     local h = 15000
  4.     gen float x_plac = importo_lotto - `c'
  5.     gen byte below_plac = (importo_lotto < `c')
  6.     gen float kw_plac = max(0, 1 - abs(x_plac)/`h') if abs(x_plac) <= `h'
  7. 
.     di as text "  Cutoff `ck'k (below 139k only, h=15k):"
