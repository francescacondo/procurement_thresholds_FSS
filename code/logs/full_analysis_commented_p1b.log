. capture program drop bunch_grp

. program define bunch_grp, rclass
  1.     * args: postfile handle, grouping, level, period, bootstrap draws
.     * Data in memory: the lots of one period × group cell.
.     args ph grouping level per B
  2.     gen double bin = ceil(importo_lotto / 1000) * 1000 - 500
  3.     quietly keep if bin > 100000 & bin < 200000
  4.     local nl = _N
  5.     gen byte one = 1
  6.     collapse (sum) n = one, by(bin)
  7.     * Keep all 100 bins, with zero lots where a bin is empty
.     tempfile have
  8.     quietly save `have'
  9.     clear
 10.     quietly set obs 100
 11.     gen double bin = 100000 + _n * 1000 - 500
 12.     quietly merge 1:1 bin using `have', nogen
 13.     quietly replace n = 0 if missing(n)
 14.     gen double z = (bin - 139000) / 1000
 15.     forvalues j = 2/7 {
 16.         gen double z`j' = z^`j'
 17.     }
 18.     gen byte r10 = mod(bin + 500, 10000) == 0
 19.     gen byte r5  = mod(bin + 500, 5000) == 0 & !r10
 20.     gen byte ex  = bin > 134000 & bin < 144000
 21.     quietly regress n z z2-z7 r10 r5 if !ex
 22.     quietly predict double cf
 23.     quietly predict double res, residuals
 24.     quietly summarize n if ex & bin < 139000
 25.     local a = r(sum)
 26.     quietly summarize cf if ex & bin < 139000
 27.     local b_hat = (`a' - r(sum)) / r(mean)
 28.     * Residual bootstrap, as in 3.3 (fit rows first, resample their residu
> als)
.     sort ex bin
 29.     quietly count if !ex
 30.     local nf = r(N)
 31.     forvalues r = 1/`B' {
 32.         quietly {
 33.             gen double nb = cf + res[ceil(runiform() * `nf')] if !ex
 34.             replace nb = n if ex
 35.             replace nb = max(0, nb)
 36.             regress nb z z2-z7 r10 r5 if !ex
 37.             predict double cfb
 38.             summarize nb if ex & bin < 139000
 39.             local ab = r(sum)
 40.             summarize cfb if ex & bin < 139000
 41.             post `ph' ("`grouping'") ("`level'") ("`per'") (`r') ((`ab' - 
> r(sum)) / r(mean))
 42.             drop nb cfb
 43.         }
 44.     }
 45.     return scalar b = `b_hat'
 46.     return scalar n_lots = `nl'
 47. end

