>             absorb(cpv2 region ym) vce(cluster authority_id)
 12.         if !_rc {
 13.             di as text "    `var': " %8.4f _b[1.below_plac] " (" %7.4f _se
> [1.below_plac] ")"
 14.             rpost Mplac c`ck' `var', coef(1.below_plac)
 15.         }
 16.     }
