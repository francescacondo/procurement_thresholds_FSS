. foreach ph in 2 3 {
  2.     local f "results/tables/net_tab_phase`ph'$NET_SFX.tex"
  3.     if `ph' == 2 local mt `""Incumbent" "Prior, not inc." "Indirect" "Outs
> ider" "New" "Return gap""'
  4.     else         local mt `""Degree" "log(1+deg)" "Regions" "Core" "Other 
> auth." "Deg. excess (alloc.)""'
  5.     esttab itt`ph'_1 itt`ph'_2 itt`ph'_3 itt`ph'_4 itt`ph'_5 itt`ph'_6 usi
> ng "`f'", replace ///
>         booktabs keep(1.below#1.post) coeflabels(1.below#1.post "Below \$\tim
> es\$ Post") ///
>         cells(b(fmt(4)) se(fmt(4) par) p(fmt(3) par([ ]))) ///
>         stats(p0mean N, labels("$NET_PRELAB below-cutoff mean" "N") fmt(4 %9.
> 0fc)) ///
>         mtitles(`mt') nonotes collabels(none) ///
>         prehead("\begin{tabular}{l*{6}{c}}" "\toprule") ///
>         posthead("\midrule" "\multicolumn{7}{l}{\textit{Panel A: reduced form
>  (ITT)}}\\") ///
>         prefoot("\midrule") postfoot(" ")
  6.     esttab iv`ph'_1 iv`ph'_2 iv`ph'_3 iv`ph'_4 iv`ph'_5 iv`ph'_6 using "`f
> '", append ///
>         booktabs keep(direct) coeflabels(direct "Direct award") ///
