. * ===========================================================================
> ===
. * 4.4  QUICK-CHECK FIGURES (results/figures/net_fig_*.png)
. * ===========================================================================
> ===
. * WHY? Each figure lets a reader check one step of the analysis at a glance:
. *  (1) binned shares around 139k, P0 vs P2  -> is there a jump only after the
>  reform?
. *  (2) composition of winners by cell       -> what the five classes look lik
> e
. *  (3) shares by half-year, below vs above  -> timing of the change
. *  (4) main coefficients with 95% CIs       -> the decomposition (sums to 0)
. *  (5) robustness coefficients              -> stability across specification
> s
. * Binned plots are descriptive: unweighted bin means with unweighted linear f
> its
. * on each side, no fixed effects (the regressions are the estimates).
. di as text _n "--- 4.4 Quick-check figures ---"

--- 4.4 Quick-check figures ---
. gen byte net_tie = net_incumbent + net_prior_other
. label var net_tie "Existing tie (incumbent + prior)"
. 
. * (1) Binned RD plots, P0 vs P2 ---------------------------------------------
> -----
. preserve
. keep if main_sample == 1 & abs(x) <= 40000
(568,809 observations deleted)
. gen bin = floor(x/2000)*2000 + 1000
. replace bin = 39000 if bin == 41000      // x = +40,000 exactly joins the las
> t bin
(19 real changes made)
. collapse (mean) net_tie net_newobs net_outsider net_indirect, by(period bin)
. local t_net_tie       "Existing tie (incumbent + prior)"
. local t_net_newobs    "New: no award in market (24m)"
. local t_net_outsider  "Outsider: awards elsewhere, no path"
. local t_net_indirect  "Indirect: two steps from authority"
. foreach v in net_tie net_newobs net_outsider net_indirect {
  2.     twoway (scatter `v' bin if period == 0, mcolor(gs10) msymbol(Oh) msize
> (small)) ///
>         (scatter `v' bin if period == 2, mcolor(navy) msize(small)) ///
>         (lfit `v' bin if period == 0 & bin < 0, lcolor(gs10)) ///
>         (lfit `v' bin if period == 0 & bin > 0, lcolor(gs10)) ///
>         (lfit `v' bin if period == 2 & bin < 0, lcolor(navy)) ///
>         (lfit `v' bin if period == 2 & bin > 0, lcolor(navy)), ///
>         xline(0, lcolor(cranberry)) title("`t_`v''", size(medsmall)) ///
>         xtitle("Lot value - 139,000 (EUR)", size(small)) ytitle("Share of lot
> s", size(small)) ///
>         xlabel(-40000 "-40k" -20000 "-20k" 0 "0" 20000 "20k" 40000 "40k", lab
> size(small)) ///
>         legend(order(1 "$NET_PRELAB (pre-reform)" 2 "P2 (post-reform)") rows(
> 1) size(small) position(6)) ///
>         graphregion(color(white)) name(g_`v', replace)
  3. }
