. * ===========================================================================
> ===
. * net_estimation.do — NETWORK EXTENSION: ALL ESTIMATION (called by net_master
> .do)
. *
. * Merges the Python-built network measures (net_lot_measures.dta, keyed on ci
> g)
. * into lots_winners.dta and estimates them with EXACTLY the specification of
. * full_analysis_commented.do (section 5.3):
. *
. *   reghdfe Y i.below##i.post##c.x [aw=kw40] if main_sample==1 & abs(x)<=4000
> 0,
. *       absorb(cpv2_post region_post ym) vce(cluster authority_id)
. *
. * and the IV version (direct instrumented by below_post) with ivreghdfe.
. * Reported for every outcome: the 1.below#1.post coefficient, SE, p-value, N,
. * and the P0 below-cutoff mean of the outcome in the estimation sample.
. *
. * All specifications (including robustness and placebos) were fixed before an
> y
. * Phase 4 coefficient was seen; see results/net_note.md, Phase 4.
. *
. * Assumes the working directory is $ROOT (set by net_master.do).
. * ===========================================================================
> ===
. 
. * ===========================================================================
> ===
. * COMPARISON PERIOD: global NET_PRE = P0 (main) or P1B (mirror)
. * ===========================================================================
> ===
. * WHY a mirror? The main design compares P2 with P0 (Jan 2018–16 Jul 2020). T
> he
. * mirror compares P2 with P1b (15 Sep 2020–31 May 2021, L. 120/2020): direct 
> award
. * below 75k, and a negotiated procedure (>= 5 operators) from 75k to the EU
. * threshold, i.e. the SAME procedure on both sides of 139k (text in force on
. * 1 Oct 2020, data/raw/law/DL_76_2020_art1_vigente_2020-10-01.html). P1b is m
> uch
. * closer in time to P2, so slow trends matter less; it is shorter, so power i
> s lower.
. * Implementation: in the mirror, P1b lots take the label period == 0 and P0 l
> ots
. * are parked as period == 9, so every estimation line below is unchanged.
. * Mirror outputs carry the suffix _p1b.
. if `"$NET_PRE"' == "" global NET_PRE "P0"

. if "$NET_PRE" == "P0" {
.     global NET_SFX ""
.     global NET_PRELAB "P0"
.     global NET_BANDLO 40000          // band that became direct-eligible: 40k
> –139k
. }

. else if "$NET_PRE" == "P1B" {
.     global NET_SFX "_p1b"
.     global NET_PRELAB "P1b"
.     global NET_BANDLO 75000          // in P1b, lots below 75k were already d
> irect-eligible
. }

. else {
.     di as error "NET_PRE must be P0 or P1B"
.     exit 198
. }

. capture program drop net_recode_pre

. program define net_recode_pre
  1.     * relabel the comparison period as period == 0 (no-op for P0)
.     if "$NET_PRE" == "P1B" {
  2.         replace period = 9 if period == 0
  3.         replace period = 0 if period == 1 & pub_date >= td(15sep2020)
  4.     }
  5. end

. di as text "  Comparison period: $NET_PRELAB vs P2 (output suffix: '$NET_SFX'
> )"
  Comparison period: P0 vs P2 (output suffix: '')

. 
. 
. * ===========================================================================
> ===
. * HELPER PROGRAMS (defined at top level: Stata forbids program define inside 
> { })
. * ===========================================================================
> ===
. capture program drop net_store

. program define net_store
  1.     args spec outcome coef name p0cond
  2.     if `"`p0cond'"' == "" local p0cond "period == 0 & below == 1"
  3.     local b  = _b[`coef']
  4.     local se = _se[`coef']
  5.     local df = e(df_r)
  6.     if missing(`df') local p = 2*normal(-abs(`b'/`se'))
  7.     else             local p = 2*ttail(`df', abs(`b'/`se'))
  8.     quietly summarize `outcome' if e(sample) & `p0cond', meanonly
  9.     local m0 = r(mean)
 10.     quietly estadd scalar p0mean = `m0'
 11.     quietly estadd scalar pval = `p'
 12.     estimates store `name'
 13.     post net_res ("`spec'") ("`outcome'") (`b') (`se') (`p') (e(N)) (`m0')
 14.     di as text %-12s "`spec'" %-22s "`outcome'" " b=" %9.4f `b' " se=" %8.
> 4f `se' ///
>         " p=" %6.4f `p' " N=" %7.0f e(N) " P0mean=" %8.4f `m0'
 15. end

. 
. capture program drop net_robust

. program define net_robust
  1.     args spec label coef cmd p0cond
  2.     local outs net_incumbent net_prior_other net_indirect net_outsider net
> _newobs net_return_gap
  3.     local suffix "`spec'"
  4.     local k 0
  5.     local names ""
  6.     foreach y of local outs {
  7.         local ++k
  8.         local yy "`y'"
  9.         * versions of the network: replace the outcome by its suffixed ver
> sion
.         if inlist("`spec'", "w12", "base", "cpv3", "mo", "y24") local yy "`y'
> _`spec'"
 10.         local c : subinstr local cmd "@" "`yy'", all
 11.         quietly `c'
 12.         net_store "`spec'" `yy' "`coef'" rb_`k' "`p0cond'"
 13.         local names "`names' rb_`k'"
 14.     }
 15.     esttab `names' using "results/tables/net_tab_robustness$NET_SFX.tex", 
> append ///
>         booktabs fragment keep(`coef') coeflabels(`coef' "`label'") ///
>         cells(b(fmt(4)) se(fmt(4) par) p(fmt(3) par([ ]))) ///
>         nomtitles nonumbers nonotes nolines collabels(none) noobs
 16.     estimates drop rb_*
 17. end

. 
