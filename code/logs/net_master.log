. * ---- Event study: exposure × half-year, reference 2020H1 ------------------
> ------
. * WHY? Tests for pre-trends (coefficients before 2020H2 should be ~0) and sho
> ws
. * when any change starts. All half-years 2016H1–2023H2, including P1 and P3.
. * NOTE: the interactions are built by hand. Written as ib`ref'.halfyear#c.exp
> osure
. * (no main effect), Stata keeps ALL half-years and reghdfe then drops the LAS
> T one
. * as collinear with the authority FE, silently moving the reference period.
. local ref = cond("$NET_PRE" == "P0", yh(2020,1), yh(2021,1))
. local esvars ""
. forvalues h = `=yh(2016,1)'/`=yh(2023,2)' {
  2.     if `h' == `ref' continue
  3.     gen float es_`h' = exposure * (halfyear == `h')
  4.     local esvars "`esvars' es_`h'"
  5. }
. foreach y in net_rewire net_excl_share {
  2.     quietly reghdfe `y' `esvars' if inrange(halfyear, yh(2016,1), yh(2023,
> 2)), ///
>         absorb(authority_id halfyear ncbin) vce(cluster authority_id)
  3.     tempfile es
  4.     capture postclose esh
  5.     postfile esh hy b se using `es'
  6.     forvalues h = `=yh(2016,1)'/`=yh(2023,2)' {
  7.         if `h' == `ref' post esh (`h') (0) (0)
  8.         else post esh (`h') (_b[es_`h']) (_se[es_`h'])
  9.     }
 10.     postclose esh
 11.     * joint test that all pre-reform coefficients are zero (2016H1-2019H2 
> for P0; 2016H1-2020H2 for P1b)
.     local pre ""
 12.     local preto = cond("$NET_PRE" == "P0", yh(2019,2), yh(2020,2))
 13.     forvalues h = `=yh(2016,1)'/`preto' {
 14.         local pre "`pre' es_`h'"
 15.     }
 16.     quietly test `pre'
 17.     di as text "  `y': joint test of pre-reform coefficients = 0: F = " %6
> .2f r(F) ", p = " %6.4f r(p)
 18.     preserve
